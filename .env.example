# Copy this file to .env and fill in the values. The .env is NEVER committed.

# The URI of your MongoDB Atlas cluster.
# Atlas > Connect > Drivers. Replace <db_password> with the real password and add
# the database name before the "?":
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/encyclopedia-punkorum?retryWrites=true&w=majority

# The address of the frontend allowed to call this API (CORS). In production this is
# the Netlify URL: anything else and every request from the site is rejected.
FRONTEND_URL=http://localhost:5173

# The server port. On Render this is provided automatically — leave it unset there.
PORT=3001

# MusicBrainz asks for a way to reach you. Optional: there is a default.
MB_USER_AGENT=EncyclopediaPunkorum/1.0 ( your-email@example.com )

# Signing secret for the JWT tokens. REQUIRED: the server refuses to start without
# it. Generate a long random string, for instance with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
TOKEN_SECRET=
