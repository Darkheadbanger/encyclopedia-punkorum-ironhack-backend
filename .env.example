# Copier ce fichier en .env et remplir les valeurs. Le .env n'est JAMAIS commité.

# L'URI de ton cluster MongoDB Atlas.
# Atlas > Connect > Drivers. Remplace <db_password> par ton vrai mot de passe et
# ajoute le nom de la base avant le "?" :
MONGODB_URI=mongodb+srv://UTILISATEUR:MOTDEPASSE@cluster0.xxxxx.mongodb.net/encyclopedia-punkorum?retryWrites=true&w=majority

# L'adresse du frontend autorisé à appeler cette API (CORS).
FRONTEND_URL=http://localhost:5173

# Le port du serveur.
PORT=3001

# MusicBrainz demande un moyen de contact.
MB_USER_AGENT=EncyclopediaPunkorum/1.0 ( ton-email@exemple.com )
